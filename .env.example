APP_ENV=dev
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Token from @BotFather (keep secret, never commit)
BOT_TOKEN=
# Public HTTPS URL of the Mini App, e.g. https://xxxx.trycloudflare.com/webapp/
WEBAPP_URL=
# Set to false to run only the web API without the Telegram bot
RUN_BOT=true
