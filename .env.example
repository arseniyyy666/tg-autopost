APP_ENV=dev
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Token from @BotFather (keep secret, never commit)
BOT_TOKEN=
# Public HTTPS URL of the Mini App, e.g. https://xxxx.trycloudflare.com/webapp/
WEBAPP_URL=
# Set to false to run only the web API without the Telegram bot
RUN_BOT=true
# From https://my.telegram.org -> API development tools (keep secret)
API_ID=
API_HASH=
# Encryption keys for stored Telegram sessions, format "version:base64key[,version:base64key]".
# Generate: python -c "import os,base64;print('1:'+base64.urlsafe_b64encode(os.urandom(32)).decode())"
# The highest version encrypts new data; older ones stay only to read old data. LOSING THE KEY = ALL SESSIONS LOST.
SESSION_KEYS=
